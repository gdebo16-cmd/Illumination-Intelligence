{
  "1": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "RealESRGAN_x4plus.safetensors"
    },
    "_meta": {
      "title": "Fast 4× model (Real-ESRGAN, or Nomos when Photo 4× is picked). Always 4×."
    }
  },
  "2": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "1",
        0
      ],
      "image": [
        "14",
        0
      ]
    },
    "_meta": {
      "title": "Faithful enlarge (tiles on its own, so video memory stays small)"
    }
  },
  "3": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "upscale_method": "lanczos",
      "width": 2048,
      "height": 2048,
      "crop": "disabled"
    },
    "_meta": {
      "title": "Only for the old 2× button: shrink the 4× result. Fast 4× skips this box."
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "2",
        0
      ],
      "filename_prefix": "Prism/prism-upscale"
    }
  },
  "14": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    },
    "_meta": {
      "title": "Your picture"
    }
  }
}
